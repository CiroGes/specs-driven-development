{
  "name": "specs-driven-development",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "hello": "tsx src/app.ts",
    "random-calc": "tsx -e \"import { runRandomIntegerCalculatorFeature } from './src/features/random-integer-calculator/index.js'; console.log(runRandomIntegerCalculatorFeature())\"",
    "mcp:start": "node mcp/sdd-context-server.mjs",
    "mcp:self-check": "node mcp/sdd-context-server.mjs --self-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate:specs": "node scripts/validate-spec-structure.mjs",
    "map:specs": "node scripts/map-spec-to-code.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@types/node": "^22.13.10",
    "eslint": "^9.20.1",
    "globals": "^15.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vitest": "^3.0.7",
    "zod": "^4.3.6"
  }
}
