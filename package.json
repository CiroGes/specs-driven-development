{
  "name": "specs-driven-development",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "install:skeleton": "node scripts/install-sdd-skeleton.mjs",
    "adapters:build": "node scripts/build-agent-adapters.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/build-agent-adapters.mjs && node scripts/install-hooks.mjs",
    "hello": "npm run example:hello",
    "random-calc": "npm run example:random-calc",
    "example:hello": "tsx examples/sdd-demo/src/app.ts",
    "example:random-calc": "tsx -e \"import { runRandomIntegerCalculatorFeature } from './examples/sdd-demo/src/features/random-integer-calculator/index.js'; console.log(runRandomIntegerCalculatorFeature())\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate:specs": "node scripts/validate-spec-structure.mjs --features-dir=examples/sdd-demo/specs/features",
    "map:specs": "node scripts/map-spec-to-code.mjs --features-dir=examples/sdd-demo/specs/features",
    "coverage:specs": "node scripts/check-spec-coverage.mjs --features-dir=examples/sdd-demo/specs/features"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.20.1",
    "globals": "^15.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vitest": "^3.0.7"
  }
}
